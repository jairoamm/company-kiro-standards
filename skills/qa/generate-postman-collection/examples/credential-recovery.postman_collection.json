{
  "info": {
    "_postman_id": "00000000-0000-4000-8000-000000000009",
    "name": "HU-DEMO-001 - Recuperación de credenciales",
    "description": "Colección sintética para explorar y reproducir CP-009. La regresión versionada permanece en Karate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Recuperación de credenciales",
      "item": [
        {
          "name": "CP-009 solicitar recuperación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa.recovery@example.test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/credential-recovery",
              "host": ["{{BASE_URL}}"],
              "path": ["credential-recovery"]
            },
            "description": "Reproducción rápida con datos sintéticos; no sustituye la regresión Karate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-009 returns 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "pm.test('response does not echo the email', function () {",
                  "  var payload = pm.response.json();",
                  "  pm.expect(payload).not.to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ],
  "event": [],
  "variable": []
}
